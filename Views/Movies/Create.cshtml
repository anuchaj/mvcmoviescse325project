@model MvcMovie.Models.Movie

@{
    ViewData["Title"] = "Add Movie";
}

<div class="form-page">

    <h1>Add a Movie</h1>

    <p>Add a movie to Joe's movie collection.</p>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" placeholder="Enter movie title" />
            <span asp-validation-for="Title" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ReleaseDate"></label>
            <input asp-for="ReleaseDate" type="date" />
            <span asp-validation-for="ReleaseDate" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Genre"></label>
            <input asp-for="Genre" placeholder="Example: Action" />
            <span asp-validation-for="Genre" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price"></label>
            <input asp-for="Price" type="number" step="0.01" placeholder="0.00" />
            <span asp-validation-for="Price" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Rating"></label>
            <input asp-for="Rating" placeholder="Example: PG-13" />
            <span asp-validation-for="Rating" class="validation-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">
                Add Movie
            </button>

            <a asp-action="Index" class="btn-secondary">
                Cancel
            </a>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
