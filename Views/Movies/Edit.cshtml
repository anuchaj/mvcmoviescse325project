@model MvcMovie.Models.Movie

@{
    ViewData["Title"] = "Edit Movie";
}

<div class="form-page">

    <h1>Edit Movie</h1>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ReleaseDate"></label>
            <input asp-for="ReleaseDate" type="date" />
            <span asp-validation-for="ReleaseDate" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Genre"></label>
            <input asp-for="Genre" />
            <span asp-validation-for="Genre" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price"></label>
            <input asp-for="Price" type="number" step="0.01" />
            <span asp-validation-for="Price" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Rating"></label>
            <input asp-for="Rating" />
            <span asp-validation-for="Rating" class="validation-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">
                Save Changes
            </button>

            <a asp-action="Index" class="btn-secondary">
                Cancel
            </a>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
